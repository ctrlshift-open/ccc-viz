{
  "name": "cc-viz",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "bg:dev": "mkdir -p tmp && kill -9 $(lsof -ti:5174) 2>/dev/null; nohup pnpm dev > tmp/output.log 2>&1 & echo $! > tmp/server.pid",
    "bg:dev-clear-cache": "mkdir -p tmp && kill -9 $(lsof -ti:5174) 2>/dev/null; nohup pnpm dev > tmp/output.log 2>&1 & echo $! > tmp/server.pid",
    "bg:stop": "[ -f tmp/server.pid ] && kill $(cat tmp/server.pid) || echo 'No server running'",
    "bg:logs": "tail -50 tmp/output.log",
    "bg:logs-watch": "tail -f tmp/output.log",
    "bg:status": "[ -f tmp/server.pid ] && ps -p $(cat tmp/server.pid) >/dev/null && echo 'Server running (PID: '$(cat tmp/server.pid)')' || echo 'Server not running'",
    "bg:restart": "pnpm run bg:stop && sleep 2 && pnpm run bg:dev",
    "bg:clean": "rm -rf tmp/",
    "prepack": "react-router build"
  },
  "bin": {
    "cc-viz": "bin/cc-viz.js"
  },
  "files": [
    "build/**",
    "bin/**",
    "public/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-router/fs-routes": "^7.8.2",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "ansi_up": "^6.0.6",
    "ccusage": "^16.2.3",
    "isbot": "^5.1.27",
    "lucide-react": "^0.542.0",
    "nanoid": "^5.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "9.0.3",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@react-router/dev": "^7.7.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.1"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
